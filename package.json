{
  "private": true,
  "name": "fla",
  "version": "0.0.1",
  "description": "Fla coding agent",
  "keywords": [
    "fla",
    "agent",
    "coding-agent",
    "ai"
  ],
  "license": "MIT",
  "author": "Paulo Flausino",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
